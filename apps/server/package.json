{
  "name": "@felt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --no-warnings src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --log-level=warning",
    "start": "node --no-warnings dist/server.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vapid": "node -e \"const w=require('web-push');const k=w.generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@hono/node-server": "1.13.8",
    "hono": "4.6.20",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@felt/core": "workspace:*",
    "@types/node": "22.13.4",
    "@types/web-push": "3.6.4",
    "esbuild": "0.24.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
