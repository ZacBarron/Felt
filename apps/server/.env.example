# Copy to .env (never commit it) or set these in your host's dashboard.

# Public address of the app, used in sign in emails and Stripe return links.
APP_URL=https://felt.example.com
# SQLite file. In production put it on a persistent disk, e.g. /data/felt.sqlite.
DATABASE_PATH=./data/felt.sqlite
# Built web app to serve from the same server.
WEB_DIR=../web/dist
NODE_ENV=production

# Sign in emails (resend.com). Without a key, codes are only printed to the log.
RESEND_API_KEY=
EMAIL_FROM=Felt <login@felt.example.com>

# Passkeys (Face ID, a fingerprint or a device PIN). Off unless both are set.
# RP ID: the domain the app's pages are on. Origins: their exact origins, comma separated.
# The GitHub Pages copy: WEBAUTHN_RP_ID=zacbarron.github.io and WEBAUTHN_ORIGINS=https://zacbarron.github.io
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# Name shown in passkey prompts (default Felt).
WEBAUTHN_RP_NAME=

# Other sites allowed to call /api from a browser (CORS), comma separated. Empty means same origin only.
# The GitHub Pages copy: ALLOWED_ORIGINS=https://zacbarron.github.io
ALLOWED_ORIGINS=

# Felt Pro (stripe.com): secret key, webhook signing secret and the two price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=
TRIAL_DAYS=7

# Study reminders: generate once with `pnpm --filter @felt/server vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI coach for Felt Pro players (console.anthropic.com). Without a key the coach is off.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5), effort (low, medium, high, xhigh or max; default medium)
# and messages per player per day (default 40).
COACH_MODEL=
COACH_EFFORT=
COACH_DAILY_LIMIT=
