{
  "name": "felt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @felt/web dev",
    "dev:server": "pnpm --filter @felt/server dev",
    "build": "pnpm --filter @felt/web build",
    "build:server": "pnpm build && pnpm --filter @felt/server build",
    "start": "WEB_DIR=${WEB_DIR:-apps/web/dist} node --no-warnings apps/server/dist/server.cjs",
    "preview": "pnpm --filter @felt/web preview",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test",
    "build:site": "pnpm --filter @felt/site build",
    "build:domain": "node scripts/build-domain.mjs",
    "dev:site": "pnpm --filter @felt/site dev",
    "bank:scenarios": "pnpm --filter @felt/content bank:scenarios"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
